# Backend Production Environment Variables
# Copy this file to .env for production

# Server Configuration
PORT=5000
NODE_ENV=production

# Firebase Admin SDK (LEGACY - no longer used at runtime)
# These are kept only for historical reference and should not be
# required for new deployments. Do not wire new code to these.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="your-private-key-here"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Auth rate limit (requests per 15 min per IP for /api/auth)
AUTH_RATE_LIMIT_MAX=50

# Logging (optional: debug, info, warn, error)
# LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database - MongoDB Atlas
# Option 1: Full connection string (recommended)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.i8n2lco.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Option 2: Build from components (if MONGODB_URI not set)
MONGODB_USERNAME=your_atlas_username
MONGODB_PASSWORD=your_atlas_password
MONGODB_CLUSTER=cluster0.i8n2lco.mongodb.net
MONGODB_DATABASE=shef-lms

# Database name override (used with MONGODB_URI)
MONGO_DB_NAME=shef-lms

# Direct connection string (no SRV) - use if Docker has DNS issues
# MONGODB_URI_STANDARD=mongodb://user:pass@host1:27017,host2:27017/db?ssl=true&replicaSet=...

# Email Configuration (Optional for notifications)
# Email Service Configuration for Batch Email Feature
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_password
EMAIL_FROM=your_email@gmail.com

# Legacy SMTP Configuration (deprecated, use EMAIL_* variables above)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Application URL
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# Zoom API Configuration
# Get these from https://marketplace.zoom.us/ → Develop → Build App → Server-to-Server OAuth
ZOOM_ACCOUNT_ID=your_zoom_account_id_here
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here

# Google Meet via Calendar API
# Preferred when org policy blocks SA keys (iam.disableServiceAccountKeyCreation):
# OAuth for one Workspace host user — see docs/GOOGLE_MEET_DEV_SETUP.md
#   ENV_PATH=.env.dev node scripts/setup-meet-oauth.js
GOOGLE_MEET_ENABLED=false
GOOGLE_MEET_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_MEET_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_MEET_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
GOOGLE_MEET_REFRESH_TOKEN=your_refresh_token_from_setup_script
GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_HOST_EMAIL=admin@lms.skystates.us
# Drive recordings (same OAuth token; enable Google Drive API + re-run setup-meet-oauth.js for drive.file)
GOOGLE_DRIVE_ROOT_FOLDER=Sky States LMS Recordings
GOOGLE_DRIVE_SHARE_DOMAIN=skystates.us
# Live-class attendance alerts (trainer intimations + admin streak emails)
ATTENDANCE_ALERT_THRESHOLD=70
ATTENDANCE_STREAK_ALERT=3
ENGAGEMENT_INACTIVE_DAYS=14
ENGAGEMENT_PASSIVE_JOIN_FLOOR=40
ADMIN_ALERT_EMAILS=support@skystates.us
# Gemini (Assessment Studio + Meet session summaries)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional SA fallback (only if org allows key creation + domain-wide delegation)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# GOOGLE_WORKSPACE_IMPERSONATE=classes@yourdomain.com


# YouTube API Configuration
# Get these from https://console.developers.google.com/ → Create Project → Enable YouTube Data API v3
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:5000/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here
